---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist.">
  <section class="wrap py-24">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight">Nothing here.</h1>
    <p class="mt-4 text-muted">The page you asked for does not exist. <a href="/" class="text-fg underline underline-offset-4">Go to the home page</a>.</p>
  </section>
</Base>
