---
import CopyButton from './CopyButton';
interface Props { code: string; title?: string; lang?: string; copy?: boolean; wrap?: boolean }
const { code, title, lang = 'bash', copy = true, wrap = false } = Astro.props;
---
<div class="overflow-hidden rounded-lg border border-line bg-sunken">
  {(title || copy) && (
    <div class="flex items-center justify-between gap-3 border-b border-line px-3 py-1.5">
      <span class="font-mono text-xs text-muted">{title ?? lang}</span>
      {copy && <CopyButton client:visible text={code} />}
    </div>
  )}
  <pre class={`p-4 text-[0.8rem] leading-relaxed text-fg ${wrap || lang === 'text' ? 'whitespace-pre-wrap break-words' : 'overflow-x-auto'}`}><code>{code}</code></pre>
</div>
