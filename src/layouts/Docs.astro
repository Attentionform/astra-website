---
import Base from './Base.astro';
import { docsPages } from '../docs-nav';
import { site } from '../site.config';
import { routePath } from '../lib/route';

interface Props { title: string; description: string; page?: string }
const { title, description, page } = Astro.props;
const current = page ?? routePath(Astro.url.pathname);
const idx = docsPages.findIndex((p) => p.href === current);
const prev = idx > 0 ? docsPages[idx - 1] : undefined;
const next = idx >= 0 && idx < docsPages.length - 1 ? docsPages[idx + 1] : undefined;
---
<Base title={title} description={description}>
  <div class="wrap grid gap-10 py-12 lg:grid-cols-[14rem_minmax(0,1fr)]">
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <nav aria-label="Documentation">
        <p class="eyebrow"><a class="no-underline text-inherit" href="/docs">Documentation</a></p>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 lg:flex-col lg:gap-0.5">
          {docsPages.map((p) => (
            <li>
              <a
                href={p.href}
                aria-current={current === p.href ? 'page' : undefined}
                class="block rounded-md py-1 text-sm text-muted no-underline transition-colors hover:text-fg aria-[current=page]:font-medium aria-[current=page]:text-fg lg:px-2"
              >{p.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <article class="doc min-w-0 max-w-3xl">
      <slot />
      <footer class="mt-16 border-t border-line pt-6 text-sm">
        {(prev || next) && (
          <div class="flex flex-wrap justify-between gap-4">
            {prev ? <a href={prev.href} class="text-muted hover:text-fg">← {prev.label}</a> : <span />}
            {next && <a href={next.href} class="text-muted hover:text-fg">{next.label} →</a>}
          </div>
        )}
        <p class="mt-6 text-subtle">Found a mistake or something unclear? <a class="underline underline-offset-4" href={site.github.issues} rel="noopener">Open an issue</a>.</p>
      </footer>
    </article>
  </div>
</Base>

<style is:global>
  .doc h1 { font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 750; letter-spacing: -0.03em; line-height: 1.1; }
  .doc h2 { margin-top: 2.75rem; font-size: 1.5rem; font-weight: 650; letter-spacing: -0.02em; scroll-margin-top: 6rem; }
  .doc h3 { margin-top: 2rem; font-size: 1.1rem; font-weight: 650; scroll-margin-top: 6rem; }
  .doc p, .doc li { color: var(--fg-muted); line-height: 1.7; }
  .doc p { margin-top: 0.9rem; }
  .doc ul { margin-top: 0.8rem; list-style: disc; padding-left: 1.25rem; }
  .doc ol { margin-top: 0.8rem; list-style: decimal; padding-left: 1.25rem; }
  .doc li { margin-top: 0.35rem; }
  .doc a { color: var(--fg); text-decoration: underline; text-underline-offset: 4px; }
  .doc code { font-family: var(--font-mono, ui-monospace, monospace); font-size: 0.875em; color: var(--fg); }
  .doc .lede { margin-top: 1rem; max-width: 42rem; }
  .doc .block { margin-top: 1.1rem; }
  .doc .tbl { margin-top: 1.1rem; overflow-x: auto; border: 1px solid var(--line); border-radius: 0.5rem; }
  .doc table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .doc th { text-align: left; font-weight: 600; color: var(--fg); padding: 0.55rem 0.8rem; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .doc td { padding: 0.5rem 0.8rem; color: var(--fg-muted); vertical-align: top; border-top: 1px solid var(--line); }
  .doc tr:first-child td { border-top: 0; }
  .doc .note { margin-top: 1.25rem; border: 1px solid var(--line); border-radius: 0.5rem; padding: 0.85rem 1rem; background: rgb(255 255 255 / 0.03); }
  .doc .note p { margin: 0; }
</style>
